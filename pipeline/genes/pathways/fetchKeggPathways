#!/bin/bash
# fetch KEGG pathways

FILE_PATH=$DATA_DIR/KEGG
PATHWAYS=${FILE_PATH}/human_pathways.txt
DISEASES=${FILE_PATH}/human_diseases.json

mkdir -p $FILE_PATH

echo "Getting pathway list"
wget "http://rest.kegg.jp/list/pathway/hsa" --output-document "$PATHWAYS" || echo "Warning: Failed to fetch pathway list."

echo "Getting disease list"
wget "http://rest.kegg.jp/get/br:br08402/json" --output-document "$DISEASES" || echo "Warning: Failed to fetch disease list."

while IFS='' read -r line || [[ -n "$line" ]]; do
    arrIN=(${line})
    PATHWAY_ID=${arrIN[0]}
    PATHWAY_ID=(${PATHWAY_ID//:/ })
    PATHWAY_ID=${PATHWAY_ID[1]}
    echo "Fetching: $PATHWAY_ID"
    wget "http://rest.kegg.jp/get/${PATHWAY_ID}/kgml" --output-document ${FILE_PATH}/${PATHWAY_ID}.kgml || echo "Warning: Failed to fetch KGML for $PATHWAY_ID."
done < "$PATHWAYS"
