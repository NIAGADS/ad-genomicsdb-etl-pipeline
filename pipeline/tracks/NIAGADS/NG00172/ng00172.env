export COLLECTION_NAME=GWAS Summary Statistics for Progressive Supranuclear Palsy (PSP)
export COLLECTION_DESCRIPTION=$(cat <<'EOF'
Summary statistics for SNVs/INDELs/SVs risk association with PSP. Participants for this analysis 
were selected with whole-genome sequencing at 30x coverage from the Alzheimer's Disease Sequencing 
Project (ADSP) WGS. Included were 1,834 PSP cases and 128 controls from the 
PSP-NIH-CurePSP-Tau, PSP-CurePSP-Tau, PSP-UCLA, and AMPAD-MAYO cohorts as well as 3,008 
controls from other cohorts in the ADSP dataset. 
EOF
)
export FLATTENED_COLLECTION_DESCRIPTION="${COLLECTION_DESCRIPTION//$'\n'/ }"

export COLLECTION_KEY=NG00172

export LOG_DIR=$DATA_DIR/tracks/${COLLECTION_KEY}/logs
