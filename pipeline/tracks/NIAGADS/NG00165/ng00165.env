export COLLECTION_NAME=Multi-ancestry evidence for AD associations
export COLLECTION_DESCRIPTION=$(cat <<'EOF'
CHARGE investigators performed single common variant association, 
rare variant aggregate analyses, and targeted association analyses 
in sub-populations using the R1 WGS data from the Alzheimer1s Disease 
Sequencing Project (ADSP) to identify causal and rare variants that were 
linked to loci from the Alzheimer’s Disease (AD) GWAS. Inclusion criteria 
were genetically unique individuals who passed QC and had AD or control 
status resulting in a pooled population of 2,184 cases and 2,383 controls.
EOF
)
export FLATTENED_COLLECTION_DESCRIPTION="${COLLECTION_DESCRIPTION//$'\n'/ }"

export COLLECTION_KEY=NG00165


