export COLLECTION_NAME=Sex differences in the genetic architecture of cognitive resilience to Alzheimer's disease
export COLLECTION_DESCRIPTION=$(cat <<'EOF'
Sex stratified and interaction summary statistics memory based on cognitive and pathology data 
that were harmonized across two datasets with autopsy measures of amyloid (ROS/MAP and ACT) 
and two datasets with amyloid PET (A4 and ADNI). Resilience phenotypes were calculated using a 
latent variable modeling approach, modeling better than expected cognition for a given level of amyloid pathology. 
All GWAS described were performed in males, in females, and with a sex-interaction and were run in the combined 
autopsy dataset and in the combined PET dataset for all resilience phenotypes. 
EOF
)
export FLATTENED_COLLECTION_DESCRIPTION="${COLLECTION_DESCRIPTION//$'\n'/ }"

export COLLECTION_KEY=NG00161

export LOG_DIR=$DATA_DIR/tracks/${COLLECTION_KEY}/logs
